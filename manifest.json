{
  "manifest_version": 3,
  "name": "MeasureFlow™",
  "version": "1.0.0",
  "description": "MeasureFlow streamiline workflow operatiions with precision tools",
  "permissions": [
    "storage",
    "clipboardWrite",
    "clipboardRead",
    "activeTab",
    "tabs",
    "scripting"
  ],
  "action": {
    "default_popup": "index.html",
    "default_icon": "icon.png"
  },
"host_permissions": [
  "https://www.google.com/maps/*",
  "https://explorer-internal.eagleview.com/*",
  "https://apps.eagleview.com/measurementUi*",
  "https://www.google.com/search*",
  "https://www.zillow.com/homes/*",
  "https://www.redfin.com/*",
  "https://www.realtor.com/realestateandhomes-search/*"
]



}